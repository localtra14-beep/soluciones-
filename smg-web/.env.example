# Copia este archivo como ".env" y ajusta los valores. El archivo .env no se debe compartir ni subir a repositorios públicos.

# Puerto del servidor
PORT=3000

# Acceso de administrador (por defecto Admin / Admin).
# CÁMBIALO antes de publicar el sitio en internet.
ADMIN_USER=Admin
ADMIN_PASS=Admin

# Actívalo (1) cuando publiques el sitio con HTTPS, detrás de un proxy o hosting
TRUST_PROXY=0
COOKIE_SECURE=0
